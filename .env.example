# TAC-Procure — environment configuration template
#
# Copy this file to `.env` in the repository root and fill in the key for
# whichever provider you intend to evaluate. Inspect AI loads `.env`
# automatically from the working directory, so no shell export is needed.
#
#     cp .env.example .env        (macOS / Linux)
#     Copy-Item .env.example .env (Windows PowerShell)
#
# `.env` is git-ignored. Never commit a real key.

# --- Provider credentials: set at least one -------------------------------
# Anthropic  -> models such as anthropic/claude-opus-4-5
ANTHROPIC_API_KEY=

# OpenAI     -> models such as openai/gpt-4o
# OPENAI_API_KEY=

# Google     -> models such as google/gemini-2.5-pro
# GOOGLE_API_KEY=

# --- Optional Inspect defaults --------------------------------------------
# Default model, so `inspect eval ...` can be run without --model
# INSPECT_EVAL_MODEL=anthropic/claude-opus-4-5

# Where evaluation logs are written (default: ./logs)
# INSPECT_LOG_DIR=./logs

# --- Optional TAC-Procure override ----------------------------------------
# Point the loader at a different scenario file (e.g. a held-out split)
# TAC_PROCURE_DATA=./data/procurement_scenarios.jsonl
